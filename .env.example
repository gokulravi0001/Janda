# ==========================================
# Personal Discord User-Install Bot - Environment Config
# ==========================================

# Your Discord Bot Token (from Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=your_bot_token_here

# Your Application ID (from Discord Developer Portal -> General Information -> Application ID)
CLIENT_ID=your_application_id_here

# Your personal Discord User ID (17-20 digit number).
# Right click your Discord profile -> Copy User ID (Developer Mode must be enabled).
# Never use usernames.
OWNER_ID=your_discord_user_id_here

# Path to the authorization database file (optional, defaults to ./data/authorized_users.json)
DATABASE_PATH=./data/authorized_users.json

# Environment mode (development / production)
NODE_ENV=production
